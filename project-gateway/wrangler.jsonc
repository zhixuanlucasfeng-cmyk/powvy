{
  "name": "powvy-project-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": false
  },
  "env": {
    "jc": {
      "name": "powvy-jc-site",
      "vars": {
        "UPSTREAM_HOST": "jc-sports-day-scoring.vercel.app"
      },
      "routes": [
        {
          "pattern": "jc.powvy.org",
          "custom_domain": true
        }
      ]
    },
    "solar": {
      "name": "powvy-solar-agent-site",
      "vars": {
        "UPSTREAM_HOST": "rest-solar-agent-cm.onrender.com",
        "UPSTREAM_TIMEOUT_MS": "90000"
      },
      "routes": [
        {
          "pattern": "solar-agent.powvy.org",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SOLAR",
            "class_name": "SolarRuntime",
            "script_name": "rest-solar-production"
          }
        ]
      },
      "assets": {
        "directory": "./solar-assets",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
